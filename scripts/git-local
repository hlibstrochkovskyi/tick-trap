#!/bin/sh
# Use the local history when the managed workspace mounts .git read-only.
project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -d "$project_root/.tick-trap-git" ]; then
    exec git --git-dir="$project_root/.tick-trap-git" --work-tree="$project_root" "$@"
fi
exec git -C "$project_root" "$@"
